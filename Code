def calculate_total_mass(molecules):

    total_mass = 0.0

    for formula, coeff in molecules:
        mass = get_molecular_mass(formula)
        total_mass += mass * coeff

    return total_mass

def check_mass_conservation(reactants, products, tolerance=1e-6):

    reactant_mass = calculate_total_mass(reactants)
    product_mass = calculate_total_mass(products)

    return abs(reactant_mass - product_mass) <= tolerance

def display_mass_check(reactants, products, tolerance=1e-6):

