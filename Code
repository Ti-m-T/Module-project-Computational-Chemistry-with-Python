def balance_reaction(reactants, products):

    matrix, elements = create_balance_matrix(reactants, products)

    solution_space = null_space(matrix)

    if solution_space.size == 0:
        raise ValueError("No solution exists for the given reaction.")

    if solution_space.shape[1] > 1:
        raise ValueError("Multiple independent solutions exist; cannot determine a unique stoichiometric solution.")

    numerical_solution = solution_space[:, 0]

    coefficients = integerize_coefficients(numerical_solution)

    if not verify_atom_balance(reactants, products, coefficients):
        raise ValueError("The computed coefficients do not balance the reaction.")

    return coefficients

